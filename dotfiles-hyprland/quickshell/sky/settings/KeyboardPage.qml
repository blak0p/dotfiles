import QtQuick
import Quickshell
import Quickshell.Io
import qs

// Keyboard and language: layouts of the main keyboard (add, remove, reorder,
// switch the active one), key repeat and the shell language. Layout and repeat
// are saved in the user layer (~/.config/sky/hypr/input.lua, generated by
// scripts/sky_input.py, which keeps a .bak) and applied live with hyprctl eval;
// the language goes to ~/.config/sky/settings.json, which Config.qml watches.
Page {
    id: page
    title: I18n.t("Keyboard and language")

    readonly property string script: Qt.resolvedUrl("../scripts/sky_input.py").toString().replace("file://", "")
    readonly property string cfgDir: (Quickshell.env("XDG_CONFIG_HOME") || (Quickshell.env("HOME") + "/.config")) + "/sky"
    readonly property var rates: [10, 15, 20, 25, 30, 35, 40, 50, 60, 80]
    readonly property var delays: [150, 200, 250, 300, 400, 500, 750, 1000]
    readonly property var langs: [
        { label: I18n.t("Auto (follows the system language)"), value: "auto" },
        { label: "English", value: "en" },
        { label: "Español", value: "es" }
    ]

    property var layouts: []          // [{layout, variant}]
    property var names: ({})          // layout code -> name
    property var variantNames: ({})   // "us:intl" -> name
    property var allLayouts: []       // [{code, name}]
    property int active: 0
    property int rate: 35
    property int delay: 250
    property string error: ""
    property bool busy: false

    // add-layout flow
    property bool adding: false
    property int pickLayout: -1
    property var pickVariants: []
    property int pickVariant: 0

    Component.onCompleted: { refresh(); catalog.running = true; }
    function refresh() { dev.running = true; rateProc.running = true; delayProc.running = true; }

    function layoutLabel(l) { return page.names[l] || l; }
    function variantLabel(l, v) { return v ? (page.variantNames[l + ":" + v] || v) : ""; }
    function steps(list, cur) { return list.indexOf(cur) >= 0 ? list : list.concat([cur]).sort((a, b) => a - b); }

    Process {
        id: catalog
        command: ["python3", page.script, "layouts"]
        stdout: StdioCollector {
            onStreamFinished: {
                try {
                    const a = JSON.parse(text), n = {};
                    a.forEach(x => n[x.code] = x.name);
                    page.names = n;
                    page.allLayouts = a;
                } catch (e) {}
            }
        }
    }
    Process {
        id: variantProc
        stdout: StdioCollector {
            onStreamFinished: {
                try { page.pickVariants = JSON.parse(text); page.pickVariant = 0; } catch (e) { page.pickVariants = []; }
                const code = page.allLayouts[page.pickLayout] ? page.allLayouts[page.pickLayout].code : "";
                const m = Object.assign({}, page.variantNames);
                page.pickVariants.forEach(v => { if (v.code) m[code + ":" + v.code] = v.name; });
                page.variantNames = m;
            }
        }
    }
    Process {
        id: dev
        command: ["hyprctl", "devices", "-j"]
        stdout: StdioCollector {
            onStreamFinished: {
                try {
                    const ks = JSON.parse(text).keyboards;
                    const k = ks.find(x => x.main) || ks[0];
                    const l = (k.layout || "").split(",");
                    const v = (k.variant || "").split(",");
                    page.layouts = l.map((x, i) => ({ layout: x, variant: v[i] || "" }));
                    page.active = k.active_layout_index || 0;
                } catch (e) { page.layouts = []; }
                page.loadVariantNames();
            }
        }
    }
    // names of the configured variants (one script call per distinct layout)
    property var pending: []
    function loadVariantNames() {
        const seen = {};
        page.pending = page.layouts.filter(x => x.variant && !page.variantNames[x.layout + ":" + x.variant] && !seen[x.layout] && (seen[x.layout] = true)).map(x => x.layout);
        nextVariant();
    }
    function nextVariant() {
        if (page.pending.length === 0 || namesProc.running) return;
        namesProc.layout = page.pending[0];
        namesProc.command = ["python3", page.script, "variants", page.pending[0]];
        namesProc.running = true;
    }
    Process {
        id: namesProc
        property string layout: ""
        stdout: StdioCollector {
            onStreamFinished: {
                try {
                    const m = Object.assign({}, page.variantNames);
                    JSON.parse(text).forEach(v => { if (v.code) m[namesProc.layout + ":" + v.code] = v.name; });
                    page.variantNames = m;
                } catch (e) {}
            }
        }
        onExited: { page.pending = page.pending.slice(1); page.nextVariant(); }
    }
    Process {
        id: rateProc
        command: ["hyprctl", "getoption", "input:repeat_rate", "-j"]
        stdout: StdioCollector { onStreamFinished: { try { page.rate = JSON.parse(text).int; } catch (e) {} } }
    }
    Process {
        id: delayProc
        command: ["hyprctl", "getoption", "input:repeat_delay", "-j"]
        stdout: StdioCollector { onStreamFinished: { try { page.delay = JSON.parse(text).int; } catch (e) {} } }
    }
    Process { id: sw; onExited: page.refresh() }
    function switchTo(i) { sw.command = ["hyprctl", "switchxkblayout", "all", String(i)]; sw.running = true; }

    // save the model, then apply the same Lua live
    property string lastModel: ""
    Process {
        id: saver
        stderr: StdioCollector { id: saveErr }
        onExited: code => {
            page.busy = false;
            if (code !== 0) { page.error = saveErr.text.trim() || I18n.t("Could not save"); page.refresh(); return; }
            page.error = "";
            applier.command = ["sh", "-c", 'hyprctl eval "$(python3 "$1" eval --json "$2")"', "sh", page.script, page.lastModel];
            applier.running = true;
        }
    }
    Process { id: applier; onExited: page.refresh() }
    function commit(ls, rate, delay) {
        page.lastModel = JSON.stringify({ layouts: ls, rate: rate, delay: delay });
        page.busy = true;
        saver.command = ["python3", page.script, "save", page.cfgDir + "/hypr/input.lua", "--json", page.lastModel];
        saver.running = true;
    }
    function move(i, d) {
        const a = page.layouts.slice(), j = i + d;
        if (j < 0 || j >= a.length) return;
        const t = a[i]; a[i] = a[j]; a[j] = t;
        commit(a, page.rate, page.delay);
    }
    function remove(i) {
        if (page.layouts.length <= 1) return;
        const a = page.layouts.slice(); a.splice(i, 1);
        commit(a, page.rate, page.delay);
    }
    function addPicked() {
        const l = page.allLayouts[page.pickLayout];
        if (!l) return;
        const v = page.pickVariants[page.pickVariant];
        commit(page.layouts.concat([{ layout: l.code, variant: v ? v.code : "" }]), page.rate, page.delay);
        page.adding = false; page.pickLayout = -1; page.pickVariants = [];
    }

    // language
    Process { id: langProc }
    function setLanguage(v) { langProc.command = ["python3", page.script, "language", page.cfgDir + "/settings.json", v]; langProc.running = true; }

    Section { text: I18n.t("Keyboard layouts") }
    Card {
        Repeater {
            model: page.layouts
            delegate: SettingRow {
                required property var modelData
                required property int index
                divider: index > 0
                icon: "keyboard"
                current: index === page.active
                title: page.layoutLabel(modelData.layout)
                sub: modelData.variant ? page.variantLabel(modelData.layout, modelData.variant) : (index === page.active ? I18n.t("Active") : "")
                Row {
                    spacing: 8
                    Btn { visible: index !== page.active; text: I18n.t("Use"); onClicked: page.switchTo(index) }
                    Btn { icon: "arrow_upward"; enabled: index > 0 && !page.busy; onClicked: page.move(index, -1) }
                    Btn { icon: "arrow_downward"; enabled: index < page.layouts.length - 1 && !page.busy; onClicked: page.move(index, 1) }
                    Btn { danger: true; icon: "delete"; enabled: page.layouts.length > 1 && !page.busy; onClicked: page.remove(index) }
                }
            }
        }
        SettingRow {
            divider: true
            icon: "add"
            title: I18n.t("Add layout")
            sub: page.layouts.length <= 1 ? I18n.t("At least one layout is always kept") : ""
            Btn { text: page.adding ? I18n.t("Cancel") : I18n.t("Add"); onClicked: page.adding = !page.adding }
        }
        SettingRow {
            visible: page.adding
            divider: true
            icon: "language"
            title: I18n.t("Keyboard layout")
            Select {
                model: page.allLayouts.map(x => x.name)
                currentIndex: page.pickLayout
                placeholder: I18n.t("Choose a layout")
                onActivated: i => {
                    page.pickLayout = i;
                    variantProc.command = ["python3", page.script, "variants", page.allLayouts[i].code];
                    variantProc.running = true;
                }
            }
        }
        SettingRow {
            visible: page.adding && page.pickLayout >= 0
            divider: true
            icon: "tune"
            title: I18n.t("Variant")
            Row {
                spacing: 8
                Select {
                    model: page.pickVariants.map(v => v.code ? v.name : I18n.t("Default"))
                    currentIndex: page.pickVariant
                    onActivated: i => page.pickVariant = i
                }
                Btn { primary: true; text: I18n.t("Add layout"); enabled: !page.busy; onClicked: page.addPicked() }
            }
        }
        SettingRow {
            visible: page.error !== ""
            divider: true
            icon: "error"
            title: page.error
        }
    }

    Section { text: I18n.t("Key repeat") }
    Card {
        SettingRow {
            icon: "speed"
            title: I18n.t("Repeat rate")
            sub: I18n.t("%1 keys per second", String(page.rate))
            Select {
                model: page.steps(page.rates, page.rate).map(x => I18n.t("%1 keys per second", String(x)))
                currentIndex: page.steps(page.rates, page.rate).indexOf(page.rate)
                onActivated: i => page.commit(page.layouts, page.steps(page.rates, page.rate)[i], page.delay)
            }
        }
        SettingRow {
            divider: true
            icon: "timer"
            title: I18n.t("Repeat delay")
            sub: I18n.t("%1 ms", String(page.delay))
            Select {
                model: page.steps(page.delays, page.delay).map(x => I18n.t("%1 ms", String(x)))
                currentIndex: page.steps(page.delays, page.delay).indexOf(page.delay)
                onActivated: i => page.commit(page.layouts, page.rate, page.steps(page.delays, page.delay)[i])
            }
        }
    }

    Section { text: I18n.t("Language") }
    Card {
        SettingRow {
            icon: "language"
            title: I18n.t("Interface language")
            sub: I18n.t("Applies right away")
            Select {
                model: page.langs
                currentIndex: Math.max(0, page.langs.findIndex(x => x.value === Config.language))
                onActivated: i => page.setLanguage(page.langs[i].value)
            }
        }
    }
}
